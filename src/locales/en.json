  "faq": {
    "title": "Frequently Asked Questions",
    "subtitle": "Answers to your most common questions",
    "items": [
      {
        "question": "Is Mutqin recognized by SCFHS?",
        "answer": "Yes, Mutqin is aligned with Saudi Commission for Health Specialties (SCFHS) standards. All accredited events on the platform comply with required standards, and registered hours are officially accredited."
      },
      {
        "question": "How do I track my CME hours?",
        "answer": "You can easily track your Continuing Medical Education (CME) hours through your dashboard. Tracking is automatic when you attend events and check in via QR. You can also export reports for sync with Mumaris Plus platform."
      },
      {
        "question": "Is my data safe?",
        "answer": "Yes, your data is completely safe. We use full encryption for all data, and all servers are hosted in Saudi Arabia to ensure full compliance with local regulations."
      },
      {
        "question": "Can I cancel my account?",
        "answer": "Yes, you can cancel your account at any time from account settings. All your data will be securely deleted according to privacy policy."
      },
      {
        "question": "How do I get my certificate?",
        "answer": "You get your certificate automatically after checking in to the event via QR. The certificate will be ready for download immediately from your dashboard."
      },
      {
        "question": "What payment methods are available?",
        "answer": "We accept all local and international payment methods: Mada, Visa, Mastercard, and Apple Pay. All transactions are secure and encrypted."
      }
    ]
  },
