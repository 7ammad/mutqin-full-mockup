{
  "name": "event-med",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "node scripts/bundle-analyzer.js",
    "type-check": "next typegen && tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:report": "node scripts/cme-type-check.js",
    "type-check:json": "tsc --noEmit --pretty false > ts-errors.txt 2>&1 || true",
    "lint:json": "next lint --format json > eslint-errors.json || true",
    "check:all": "npm run type-check:report",
    "errors:view": "type cme-type-errors.json",
    "fix:detect": "node scripts/fix-typescript-errors.js",
    "fix:validate": "next typegen && tsc --noEmit",
    "fix:all": "npm run fix:detect && npm run fix:validate && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.554.0",
    "next": "16.0.3",
    "next-qrcode": "^2.5.1",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-day-picker": "^9.11.2",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.1",
    "react-pdf": "^10.2.0",
    "recharts": "^3.4.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@aivenio/tsc-output-parser": "^2.1.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-pdf": "^6.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "msw": "^2.12.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.14"
  }
}
